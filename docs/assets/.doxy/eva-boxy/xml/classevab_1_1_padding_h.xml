<codeline><highlight class="normal"><ref refid="classevab_1_1_padding_h_1acc87360742879593079f8b83ab635496" kindref="member">PaddingH&lt;InputInt&gt;</ref><sp/>paddedInput(42);</highlight></codeline>
<codeline><highlight class="normal"></highlight></codeline>
