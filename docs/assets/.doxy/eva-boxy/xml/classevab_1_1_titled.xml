</parameteritem>
<parameteritem>
<parameternamelist>
<parametername>TAlign</parametername>
</parameternamelist>
<parameterdescription>
<para>Alignment strategy for label (<ref refid="structevab_1_1_left_align" kindref="compound">LeftAlign</ref>, <ref refid="structevab_1_1_center_align" kindref="compound">CenterAlign</ref>, <ref refid="structevab_1_1_right_align" kindref="compound">RightAlign</ref>) </para>
</parameterdescription>
</parameteritem>
